---
import Icon from "./Icon.astro";
import { useTranslations, localizePath, type Lang } from "../i18n/utils";

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<section class="box skills">
    <div class="stack gap-2 lg:gap-4">
        <Icon icon="linux" color="var(--accent-regular)" size="2.5rem" />
        <h2>{t("skills.linux.title")}</h2>
        <p>
            {t("skills.linux.paragraph")}
        </p>
    </div>
    <div class="stack gap-2 lg:gap-4">
        <Icon icon="flag" color="var(--accent-regular)" size="2.5rem" />
        <h2>{t("skills.ctf.title")}</h2>
        <p>
            {t("skills.ctf.paragraph")}
        </p>
    </div>
    <div class="stack gap-2 lg:gap-4">
        <Icon icon="open-source" color="var(--accent-regular)" size="2.5rem" />
        <h2>{t("skills.open-source.title")}</h2>
        <p>{t("skills.open-source.paragraph")}</p>
    </div>
</section>

<style>
    .box {
        border: 1px solid var(--gray-700);
        border-radius: 0.75rem;
        padding: 1.5rem;
        background-color: var(--gray-100);
        box-shadow: var(--shadow-sm);
    }

    .skills {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .skills h2 {
        font-size: var(--text-lg);
        color: var(--accent-regular);
    }

    .skills p {
        color: var(--gray-900);
    }

    @media (min-width: 50em) {
        .box {
            border-radius: 1.5rem;
            padding: 2.5rem;
        }

        .skills {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 5rem;
        }

        .skills h2 {
            font-size: var(--text-2xl);
        }
    }
</style>
