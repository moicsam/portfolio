---
import ContactCTA from "../../components/ContactCTA.astro";
import Hero from "../../components/Hero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { languages } from "../../i18n/ui";
import { useTranslations, type Lang } from "../../i18n/utils";

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Données pour les associations étudiantes
const studentAssociations = {
    social: [
        {
            name: "Amicale CORE",
            description: t("engagements.core.description"),
            role: t("engagements.core.role"),
            period: "2024-2025",
        },
    ],
    representation: [
        {
            name: "Unistra",
            description: t("engagements.unistra.description"),
            role: t("engagements.unistra.role"),
            period: "2025-2026",
        },
    ],
};

// Données pour les clubs scientifiques
const scientificClubs = {
    clubs: [
        {
            name: "Club Capra",
            description: t("engagements.capra.description"),
            role: t("engagements.capra.role"),
            period: "2023-2025",
        },
    ],
    projects: [
        {
            name: t("engagements.capra.projects.vtx"),
            description: t("engagements.capra.projects.vtx.description"),
            role: t("engagements.capra.projects.vtx.role"),
            period: "2024-2025",
        },
        {
            name: t("engagements.capra.projects.lte"),
            description: t("engagements.capra.projects.lte.description"),
            role: t("engagements.capra.projects.lte.role"),
            period: "2025-2026",
        },
    ],
};
---

<BaseLayout
    title={t("engagements.title")}
    description={t("engagements.description")}
>
    <div class="stack gap-20">
        <main class="wrapper engagements">
            <Hero
                title={t("engagements.hero.title")}
                tagline={t("engagements.hero.tagline")}
            />
            <section>
                <h2 class="section-title">
                    {t("engagements.section.student_associations")}
                </h2>
                <p>{t("engagements.section.student_associations.text")}</p>

                <div class="content">
                    <div class="category-grid">
                        <div class="category">
                            <h3 class="category-title">
                                {t("engagements.associations")}
                            </h3>
                            <ul class="item-list">
                                {
                                    studentAssociations.social.map(
                                        (association) => (
                                            <li>
                                                <div class="card">
                                                    <div class="card-content">
                                                        <h4 class="title">
                                                            {association.name}
                                                        </h4>
                                                        <p class="role">
                                                            {association.role} -{" "}
                                                            {association.period}
                                                        </p>
                                                        <p class="description">
                                                            {
                                                                association.description
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                            </li>
                                        ),
                                    )
                                }
                            </ul>
                        </div>

                        <div class="category">
                            <h3 class="category-title">
                                {t("engagements.representation")}
                            </h3>
                            <ul class="item-list">
                                {
                                    studentAssociations.representation.map(
                                        (association) => (
                                            <li>
                                                <div class="card">
                                                    <div class="card-content">
                                                        <h4 class="title">
                                                            {association.name}
                                                        </h4>
                                                        <p class="role">
                                                            {association.role} -{" "}
                                                            {association.period}
                                                        </p>
                                                        <p class="description">
                                                            {
                                                                association.description
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                            </li>
                                        ),
                                    )
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <section>
                <h2 class="section-title">
                    {t("engagements.section.scientific_clubs")}
                </h2>
                <p>{t("engagements.section.scientific_clubs.text")}</p>

                <div class="content">
                    <div class="category-grid">
                        <div class="category">
                            <h3 class="category-title">
                                {t("engagements.clubs.scientific")}
                            </h3>
                            <ul class="item-list">
                                {
                                    scientificClubs.clubs.map((club) => (
                                        <li>
                                            <div class="card">
                                                <div class="card-content">
                                                    <h4 class="title">
                                                        {club.name}
                                                    </h4>
                                                    <p class="role">
                                                        {club.role} -{" "}
                                                        {club.period}
                                                    </p>
                                                    <p class="description">
                                                        {club.description}
                                                    </p>
                                                </div>
                                            </div>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>

                        <div class="category">
                            <h3 class="category-title">
                                {t("engagements.clubs.projects")}
                            </h3>
                            <ul class="item-list">
                                {
                                    scientificClubs.projects.map((project) => (
                                        <li>
                                            <div class="card">
                                                <div class="card-content">
                                                    <h4 class="title">
                                                        {project.name}
                                                    </h4>
                                                    <p class="role">
                                                        {project.role} -{" "}
                                                        {project.period}
                                                    </p>
                                                    <p class="description">
                                                        {project.description}
                                                    </p>
                                                </div>
                                            </div>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <ContactCTA />
    </div>
</BaseLayout>

<style>
    .engagements {
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    section {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        color: var(--gray-500);
    }

    .section-title {
        grid-column-start: 1;
        font-size: var(--text-xl);
        color: var(--accent-regular);
    }

    .content {
        grid-column: 2 / 4;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 1rem;
    }

    .category-title {
        font-size: var(--text-md);
        color: var(--accent-regular);
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--accent-regular);
        padding-bottom: 0.5rem;
    }

    .item-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .card {
        display: block;
        background: var(--gray-100);
        border: 1px solid var(--gray-200);
        border-radius: 0.75rem;
        box-shadow: var(--shadow-sm);
        text-decoration: none;
        color: var(--gray-900);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
        padding: 1.5rem;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .card-content {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        height: 100%;
    }

    .title {
        margin: 0;
        padding: 0;
        font-size: var(--text-lg);
        font-weight: 600;
        color: var(--accent-regular);
    }

    .role {
        margin: 0;
        padding: 0;
        font-size: var(--text-xs);
        color: var(--gray-500);
        font-style: italic;
    }

    .description {
        margin: 0;
        padding: 0;
        font-size: var(--text-sm);
        color: var(--gray-600);
    }

    @media (min-width: 50em) {
        .engagements {
            display: grid;
            grid-template-columns: 1fr 60% 1fr;
        }

        .engagements > :global(:first-child) {
            grid-column-start: 2;
        }

        section {
            display: contents;
            font-size: var(--text-lg);
        }

        .card {
            border-radius: 1.5rem;
        }

        .title {
            font-size: var(--text-xl);
        }

        .description {
            font-size: var(--text-base);
        }
    }
</style>
